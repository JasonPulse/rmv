# Copy to .env on the homelab box. docker compose reads it automatically.
# .env is gitignored; nothing in here should ever be committed.
#
# This is the environment-variable path. To keep credentials out of the container
# environment entirely, use docker-compose.secrets.yml instead and mount them as
# files. See docs/deploy.md.

# --- Postgres -------------------------------------------------------------
POSTGRES_DB=rmv
POSTGRES_USER=rmv
# Generate with: openssl rand -base64 32
# For local development use POSTGRES_PASSWORD=rmv instead, so it matches the
# connection string in src/Rmv.Web/appsettings.Development.json.
POSTGRES_PASSWORD=change-me

# --- Discord sign-in ------------------------------------------------------
# https://discord.com/developers/applications -> your app -> OAuth2
# Add this exact redirect URI there: https://YOUR-DOMAIN/signin-discord
# Leave both blank to run the site with sign-in switched off.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Cloudflare tunnel ---------------------------------------------------
# Zero Trust dashboard -> Networks -> Tunnels -> create a tunnel -> copy token.
# Then add a public hostname on that tunnel: type HTTP, URL web:8080
# (the compose service name, not localhost or an IP).
CLOUDFLARE_TUNNEL_TOKEN=

# --- Running a prebuilt image --------------------------------------------
# Leave unset to build from source on the box. Set it to run what CI published.
# WEB_IMAGE=ghcr.io/jasonpulse/rmv:latest

# Stamped into the image and shown on /status. CI sets this to the commit sha.
# BUILD_VERSION=local
