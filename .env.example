# Copy to .env on the homelab box. docker compose reads it automatically.
# .env is gitignored; nothing in here should ever be committed.

# --- Postgres -------------------------------------------------------------
POSTGRES_DB=rmv
POSTGRES_USER=rmv
# Generate with: openssl rand -base64 32
# For local development use POSTGRES_PASSWORD=rmv instead, so it matches the
# connection string in src/Rmv.Web/appsettings.Development.json.
POSTGRES_PASSWORD=change-me

# --- Discord sign-in ------------------------------------------------------
# https://discord.com/developers/applications -> your app -> OAuth2
# Add this exact redirect URI there: https://YOUR-DOMAIN/signin-discord
# Leave both blank to run the site with sign-in switched off.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Cloudflare tunnel ---------------------------------------------------
# Zero Trust dashboard -> Networks -> Tunnels -> create a tunnel -> copy token.
# Point the tunnel's public hostname at http://web:8080
CLOUDFLARE_TUNNEL_TOKEN=
