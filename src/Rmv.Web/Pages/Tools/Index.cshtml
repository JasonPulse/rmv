@page "/tools"
@{
    ViewData["Title"] = "Tools";
    ViewData["Description"] = "Player utilities for Results May Vary. Under construction.";
}

@* .hero sits outside .shell so its background spans the full viewport width.
   Nested inside, the pattern stops at the shell edge and shows a hard seam. *@
<section class="hero">
    <div class="shell">
        <div class="hero__plaque"><h1>Tools</h1></div>
        <p>Nothing here yet. This is what is coming.</p>
    </div>
</section>

<div class="shell">
    <hr class="rule" />

    <section class="section grid">
        <article class="panel panel--inset">
            <p class="panel__title">Planned</p>
            <h3>Log and image upload</h3>
            <p class="dim">Drop in a combat log or a screenshot and get it parsed.</p>
        </article>

        <article class="panel panel--inset">
            <p class="panel__title">Planned</p>
            <h3>Daily stat scrape</h3>
            <p class="dim">Two public stats pages, pulled once a day and kept in Postgres.</p>
        </article>
    </section>
</div>
