@inject SiteOptions Site
@inject IConfiguration Config
@inject IAuthorizationService Auth
@inject CurrentMember Me
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] &middot; Results May Vary</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Results May Vary, a gaming guild running since Dark Age of Camelot.")" />
    <meta name="theme-color" content="#07080c" />

    @* Icons all derive from the logo's horned helm: the full crest is unreadable
       at 32px. See tools/build-logo-assets.sh. *@
    <link rel="icon" href="~/favicon.ico" sizes="32x32" />
    <link rel="icon" href="~/img/logo/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="~/img/logo/apple-touch-icon.png" />
    <link rel="manifest" href="~/site.webmanifest" />
    @* Preload the display face: it is used by the wordmark, so a swap is visible. *@
    <link rel="preload" href="~/fonts/Vollkorn-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/rmv.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<header class="masthead">
    <div class="shell masthead__inner">
        @* Placeholder sigil. Swap for the guild logo when it is finished. *@
        <div class="sigil" aria-hidden="true"></div>

        <a class="wordmark" href="/">
            <strong>Results May Vary</strong>
            <small>Since Dark Age of Camelot</small>
        </a>

        @* Page navigation only. Account controls are their own cluster below, so
           the bar stops being a catch-all. *@
        <nav class="nav" aria-label="Main">
            <a href="/" aria-current="@Current("/Index")">Hall</a>
            <a href="/history" aria-current="@Current("/History")">History</a>
            <a href="/tools" aria-current="@Section("/Tools")">Tools</a>
        </nav>

        @if (Site.DiscordEnabled)
        {
            <div class="account">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var avatar = DiscordUser.AvatarUrl(User);
                    <button class="account__toggle" type="button"
                            aria-haspopup="true" aria-expanded="false"
                            aria-controls="account-menu" data-account-toggle>
                        @* The kit's portrait idiom: a stone diamond with a knotted
                           silver frame, which is what it was drawn for. *@
                        <span class="portrait">
                            @if (avatar is not null)
                            {
                                <img class="portrait__img" src="@avatar" alt="" width="64" height="64" />
                            }
                            else
                            {
                                <span class="portrait__initials">@DiscordUser.Initials(User)</span>
                            }
                        </span>
                        <span class="account__name">@(await Me.HandleAsync(User))</span>
                        <span class="account__caret" aria-hidden="true"></span>
                    </button>

                    <div class="menu" id="account-menu" role="menu" hidden data-account-menu>
                        <a class="menu__item" role="menuitem" href="/Account/Profile">Profile</a>
                        @if ((await Auth.AuthorizeAsync(User, MemberPolicy.Approved)).Succeeded)
                        {
                            <a class="menu__item" role="menuitem" href="/characters">My characters</a>
                        }
                        @if ((await Auth.AuthorizeAsync(User, AdminPolicy.Name)).Succeeded)
                        {
                            <a class="menu__item" role="menuitem" href="/admin/history">Edit history</a>
                            <a class="menu__item" role="menuitem" href="/admin/members">Members</a>
                            <a class="menu__item" role="menuitem" href="/admin/analytics">Analytics</a>
                            <a class="menu__item" role="menuitem" href="/status">Status</a>
                        }
                        <form method="post" asp-page="/Account/Logout">
                            <button class="menu__item menu__item--danger" role="menuitem" type="submit">Sign out</button>
                        </form>
                    </div>
                }
                else
                {
                    <a class="account__signin" href="/Account/Login">Sign in</a>
                }
            </div>
        }
    </div>
</header>

<main id="main">
    @RenderBody()
</main>

<footer class="footer">
    <div class="shell footer__inner">
        <span>Results May Vary &middot; a guild, still going</span>
        <span class="dim">Midgard, then everywhere else</span>
    </div>
</footer>

<script src="~/js/htmx.min.js" defer></script>
@if (Site.DiscordEnabled && User.Identity?.IsAuthenticated == true)
{
    <script src="~/js/account-menu.js" asp-append-version="true" defer></script>
}
@{
    // Umami, the client-side half of analytics. Renders nothing until both
    // values are configured, so the site loads no third-party script by default.
    var umamiSrc = Config["Analytics:UmamiScriptUrl"];
    var umamiId = Config["Analytics:UmamiWebsiteId"];
}
@if (!string.IsNullOrWhiteSpace(umamiSrc) && !string.IsNullOrWhiteSpace(umamiId))
{
    <script defer src="@umamiSrc" data-website-id="@umamiId"></script>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    private string Page => ViewContext.RouteData.Values["page"] as string ?? "";

    // Exact match, for a nav item that maps to one page.
    string? Current(string page) =>
        string.Equals(Page, page, StringComparison.OrdinalIgnoreCase) ? "page" : null;

    // Prefix match, so Tools stays lit on /tools/daoc and below. Without this the
    // nav goes blank as soon as you open a tool.
    string? Section(string prefix) =>
        Page.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? "page" : null;
}
