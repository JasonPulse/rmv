@page "/characters"
@model Rmv.Web.Pages.Characters.IndexModel
@{
    ViewData["Title"] = "My characters";
}

<section class="hero">
    <div class="shell">
        <div class="hero__plaque"><h1>My characters</h1></div>
        <p>
            Games with a herald we look up for you. The rest take a sheet you
            type once.
        </p>
    </div>
</section>

<div class="shell">
    <hr class="rule" />

    @{ var flash = new Rmv.Web.Pages.Shared.Flash(Model.Notice, Model.Error); }
    <partial name="_Flash" model="flash" />

    <section class="section grid grid--wide">
        <article class="panel">
            <p class="panel__title">Add one</p>

            @if (Model.Games.Count == 0)
            {
                <h3>No games yet</h3>
                <p class="dim">
                    There is nothing in the history to attach a character to. An
                    admin adds games on <a href="/admin/history">the history page</a>.
                </p>
            }
            else
            {
                <form method="post" asp-page-handler="Add" class="stack" style="--stack-gap:1rem">
                    <div asp-validation-summary="All" class="notice validation-summary"></div>

                    <div class="field">
                        <label asp-for="Input.GamePresenceId">Game</label>
                        <select class="input" asp-for="Input.GamePresenceId" data-gamepicker>
                            <option value="">Pick a game</option>
                            @foreach (var g in Model.Games)
                            {
                                <option value="@g.Id"
                                        data-herald="@(Model.HasHerald(g) ? "true" : "false")"
                                        data-optional="@(Model.NoteFor(g) is not null ? "true" : "false")">@g.Game</option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label asp-for="Input.Name">Character name</label>
                        <input class="input" asp-for="Input.Name" autocomplete="off"
                               placeholder="Exactly as it appears in game" />
                        <p class="hint" data-when="herald" hidden>
                            Spelling has to match. We ask the herald, and it is
                            fussier than we are. For the Lodestone and the Armory you
                            can paste your character's page address instead. The
                            Armory also needs the realm, so
                            <span class="mono">Syfr-Quel'Thalas</span> works too.
                        </p>
                    </div>

                    @* Only for a herald that admits it does not list everyone, which
                       today is the Armory: it shows characters on a subscribed
                       account and answers a lapsed one exactly as it answers a
                       misspelling. Visible without the script, like the manual
                       fields, so the form still works when it is blocked. *@
                    @if (Model.HeraldNotes.Count > 0)
                    {
                        <div class="field" data-when="choice">
                            <label class="check">
                                <input asp-for="Input.UseHerald" type="checkbox" data-heraldtoggle />
                                <span>Look this character up</span>
                            </label>
                            @foreach (var (id, note) in Model.HeraldNotes)
                            {
                                <p class="hint" data-note-for="@id">@note</p>
                            }
                        </div>
                    }

                    @* Shown unless the picked game has a herald, which means shown
                       by default, so this works with the script blocked. *@
                    <div data-when="manual" class="stack" style="--stack-gap:1rem">
                        <div class="field">
                            <label asp-for="Input.Class">Job or class</label>
                            <input class="input" asp-for="Input.Class" autocomplete="off"
                                   placeholder="Paladin, White Mage, Champion" />
                        </div>

                        <div class="field">
                            <label asp-for="Input.Level">Level</label>
                            <input class="input input--narrow" asp-for="Input.Level" type="number"
                                   min="@CharacterLimits.MinLevel" max="@CharacterLimits.MaxLevel" placeholder="50" />
                            <p class="hint">
                                This game has no herald, so nothing updates the sheet
                                for you. Leave a field blank if you do not remember.
                            </p>
                        </div>
                    </div>

                    <p style="margin:0"><button class="btn" type="submit">Add character</button></p>
                </form>
            }
        </article>

        <article class="panel panel--inset">
            <p class="panel__title">Yours</p>

            @if (Model.Mine.Count == 0)
            {
                <h3>Nothing yet</h3>
                <p class="dim">Characters you add appear here.</p>
            }
            else
            {
                <div class="charlist">
                    @foreach (var c in Model.Mine)
                    {
                        <div class="charcard">
                            @{
                                var card = new Rmv.Web.Pages.Shared.CharacterCard(c)
                                {
                                    ShowGame = true,
                                    ShowKills = true,
                                };
                            }
                            <partial name="_CharacterBody" model="card" />

                            @if (c.IsManual)
                            {
                                <p class="hint">Typed in by you. @(c.Game?.Game) has no herald to ask.</p>
                            }
                            else if (!string.IsNullOrWhiteSpace(c.LastError))
                            {
                                <p class="hint charcard__stale">Last refresh failed: @c.LastError</p>
                            }
                            else if (c.LastFetchedAt is not null)
                            {
                                <p class="hint">Updated @c.LastFetchedAt.Value.ToString("yyyy-MM-dd HH:mm 'UTC'")</p>
                            }

                            <div class="charcard__actions">
                                @if (!c.IsManual)
                                {
                                    <form method="post" asp-page-handler="Refresh" asp-route-id="@c.Id">
                                        <button class="linkish" type="submit">refresh</button>
                                    </form>
                                }
                                <form method="post" asp-page-handler="Remove" asp-route-id="@c.Id"
                                      onsubmit="return confirm('Remove @c.Name?')">
                                    <button class="linkish linkish--danger" type="submit">remove</button>
                                </form>
                            </div>

                            @if (c.IsManual)
                            {
                                @* Its own form per card rather than one shared form
                                   the page fills by script: nothing updates a manual
                                   sheet, so correcting a typo has to work with the
                                   script blocked. *@
                                <details class="charcard__edit">
                                    <summary class="linkish">edit sheet</summary>
                                    <form method="post" asp-page-handler="Edit" asp-route-id="@c.Id"
                                          class="stack" style="--stack-gap:0.75rem">
                                        <div class="field">
                                            <label for="edit-name-@c.Id">Name</label>
                                            <input class="input" id="edit-name-@c.Id" name="Edit.Name"
                                                   value="@c.Name" autocomplete="off" />
                                        </div>
                                        <div class="field">
                                            <label for="edit-class-@c.Id">Job or class</label>
                                            <input class="input" id="edit-class-@c.Id" name="Edit.Class"
                                                   value="@c.Class" autocomplete="off" />
                                        </div>
                                        <div class="field">
                                            <label for="edit-level-@c.Id">Level</label>
                                            <input class="input input--narrow" id="edit-level-@c.Id"
                                                   name="Edit.Level" type="number" min="@CharacterLimits.MinLevel" max="@CharacterLimits.MaxLevel"
                                                   value="@c.Level" />
                                        </div>
                                        <p style="margin:0"><button class="btn" type="submit">Save sheet</button></p>
                                    </form>
                                </details>
                            }
                        </div>
                    }
                </div>
            }
        </article>
    </section>
</div>

@section Scripts {
    <script src="~/js/character-form.js" asp-append-version="true" defer></script>
}
