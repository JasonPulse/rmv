@page "/news"
@model Rmv.Web.Pages.News.IndexModel
@{
    ViewData["Title"] = "News";
    ViewData["Description"] = "What Results May Vary has been up to.";
}

<section class="hero">
    <div class="shell">
        <div class="hero__plaque"><h1>News</h1></div>
        <p>What we have been up to, newest first.</p>
    </div>
</section>

<div class="shell">
    <hr class="rule" />

    @if (Model.Posts.Count == 0)
    {
        <p class="center dim">Nothing posted yet.</p>
    }
    else
    {
        <h2 class="visually-hidden">Posts</h2>

        <div class="gamelist">
            @foreach (var post in Model.Posts)
            {
                <article class="gameentry gameentry--active">
                    <header class="gameentry__head">
                        <h3 class="gameentry__name">
                            <a href="/news/@post.Slug">@post.Title</a>
                        </h3>
                        <span class="gameentry__period">
                            <time datetime="@post.Date.ToString("yyyy-MM-dd")">@post.Date.ToString("d MMM yyyy")</time>@if (post.Author is { } author)
                            {<text>, @author</text>}
                        </span>
                    </header>

                    <div class="gameentry__rule" aria-hidden="true"></div>

                    <p class="dim" style="margin:0">@post.Excerpt</p>
                    <p style="margin:0"><a class="btn" href="/news/@post.Slug">Read it</a></p>
                </article>
            }
        </div>
    }
</div>
