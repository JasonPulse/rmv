@page "/admin/members"
@model Rmv.Web.Pages.Admin.MembersModel
@{ ViewData["Title"] = "Members"; }

<section class="hero">
    <div class="shell">
        <div class="hero__plaque"><h1>Members</h1></div>
        <p>
            Signing in gets a seat and nothing else. Approve someone before they
            can add characters.
        </p>
    </div>
</section>

<div class="shell">
    <hr class="rule" />

    @if (Model.Error is not null)
    {
        <p class="notice">@Model.Error</p>
    }
    @if (Model.Notice is not null)
    {
        <p class="notice notice--ok">@Model.Notice</p>
    }

    <section class="section">
        <div class="panel">
            <p class="panel__title">
                Signed in at least once
                @if (Model.PendingCount > 0)
                {
                    <span class="pill pill--warn">@Model.PendingCount waiting</span>
                }
            </p>

            @if (Model.Rows.Count == 0)
            {
                <p class="dim">
                    Nobody yet. A member appears here the first time they sign in
                    with Discord.
                </p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">Member</th>
                            <th scope="col">Status</th>
                            <th scope="col">Admin</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>
                                @row.Member.Handle
                                @if (!string.IsNullOrWhiteSpace(row.Member.Alias))
                                {
                                    <span class="dim block-hint">discord: @row.Member.DisplayName</span>
                                }
                                @if (row.IsSelf)
                                {
                                    <span class="pill">you</span>
                                }
                            </td>
                            <td>
                                @switch (row.Member.Status)
                                {
                                    case MemberStatus.Approved:
                                        <span class="pill pill--ok">approved</span>
                                        break;
                                    case MemberStatus.Blocked:
                                        <span class="pill pill--bad">blocked</span>
                                        break;
                                    default:
                                        <span class="pill pill--warn">pending</span>
                                        break;
                                }
                                <span class="dim block-hint">seen @row.Member.LastSeenAt.ToString("yyyy-MM-dd")</span>
                            </td>
                            <td>
                                @if (row.IsRoot)
                                {
                                    <span class="pill pill--warn">root</span>
                                }
                                else if (row.Member.IsAdmin)
                                {
                                    <span class="pill pill--ok">yes</span>
                                }
                                else
                                {
                                    <span class="dim">no</span>
                                }
                            </td>
                            <td class="row-actions">
                                @if (row.IsRoot)
                                {
                                    <span class="dim">set in config</span>
                                }
                                else
                                {
                                    @if (row.Member.Status != MemberStatus.Approved)
                                    {
                                        <form method="post" asp-page-handler="Approve" asp-route-id="@row.Member.Id">
                                            <button class="linkish" type="submit">approve</button>
                                        </form>
                                    }
                                    @if (row.Member.IsAdmin)
                                    {
                                        <form method="post" asp-page-handler="Revoke" asp-route-id="@row.Member.Id"
                                              onsubmit="return confirm('Remove admin from @row.Member.DisplayName?')">
                                            <button class="linkish linkish--danger" type="submit">revoke admin</button>
                                        </form>
                                    }
                                    else if (row.Member.Status == MemberStatus.Approved)
                                    {
                                        <form method="post" asp-page-handler="Grant" asp-route-id="@row.Member.Id">
                                            <button class="linkish" type="submit">make admin</button>
                                        </form>
                                    }
                                    @if (row.Member.Status != MemberStatus.Blocked && !row.IsSelf)
                                    {
                                        <form method="post" asp-page-handler="Block" asp-route-id="@row.Member.Id"
                                              onsubmit="return confirm('Block @row.Member.DisplayName?')">
                                            <button class="linkish linkish--danger" type="submit">block</button>
                                        </form>
                                    }
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }

            <hr class="rule rule--fine" />

            <p class="dim">
                New sign-ins are <strong>pending</strong>: they can look around and
                nothing else. Approving lets them add characters. Blocking clears
                any admin flag too, so re-approving never silently restores it.
            </p>
            <p class="dim">
                <strong>root</strong> means the id is in <span class="mono">Admin__DiscordIds</span>.
                Those cannot be changed here on purpose: they are the way back in if
                a grant goes wrong or the database is unreachable. You also cannot
                remove your own access.
            </p>
        </div>
    </section>
</div>
