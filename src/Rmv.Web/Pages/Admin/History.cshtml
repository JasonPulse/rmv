@page "/admin/history"
@model Rmv.Web.Pages.Admin.HistoryModel
@{ ViewData["Title"] = "Edit history"; }

<section class="hero">
    <div class="shell">
        <div class="hero__plaque"><h1>Edit history</h1></div>
        <p>The "where we've been" list. Changes are live immediately.</p>
    </div>
</section>

<div class="shell">
    <hr class="rule" />

    @{ var flash = new Rmv.Web.Pages.Shared.Flash(Model.Notice); }
    <partial name="_Flash" model="flash" />

    <section class="section grid grid--wide">
        <article class="panel">
            <p class="panel__title">Games</p>
            <p class="hint" data-mode="game">Adding a new game.</p>

            <form method="post" asp-page-handler="Save" class="stack" id="game-form" style="--stack-gap:1rem">
                @* Without this a failed save is silent: the per-field messages sit
                   beside fields the operator is not looking at. *@
                <div asp-validation-summary="All" class="notice validation-summary"></div>
                <input type="hidden" asp-for="Input.Id" />

                <div class="field">
                    <label asp-for="Input.Game">Game</label>
                    <input class="input" asp-for="Input.Game" placeholder="Blackthorn DAoC" />
                    <span class="hint" asp-validation-for="Input.Game"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Guilds">Guild tags</label>
                    <input class="input" asp-for="Input.Guilds" placeholder="RMV, Legends, Dark Auspices" />
                    <p class="hint">Comma separated. Each becomes its own tag on the page.</p>
                    <span class="hint" asp-validation-for="Input.Guilds"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Period">Period</label>
                    <input class="input" asp-for="Input.Period" placeholder="2001-2012" />
                    <p class="hint">Optional.</p>
                </div>

                <div class="field">
                    <label asp-for="Input.SortOrder">Sort order</label>
                    <input class="input" asp-for="Input.SortOrder" type="number" min="0" max="999" />
                    <p class="hint">Lowest first, within its list.</p>
                </div>

                <label class="check">
                    <input asp-for="Input.IsActive" type="checkbox" />
                    <span>Still active</span>
                </label>

                <div class="field">
                    <label asp-for="Input.HeraldAdapterKey">Herald</label>
                    <select class="input" asp-for="Input.HeraldAdapterKey">
                        <option value="">None, no character lookup</option>
                        @foreach (var a in Model.Adapters)
                        {
                            <option value="@a.Key">@a.DisplayName (@a.DefaultBaseUrl)</option>
                        }
                    </select>
                    <p class="hint">
                        That is all it needs. Each adapter is written for one
                        server and already knows its address.
                    </p>
                    <span class="hint" asp-validation-for="Input.HeraldAdapterKey"></span>
                </div>

                <details class="field">
                    <summary class="hint">Override the herald address</summary>
                    <input class="input" asp-for="Input.HeraldBaseUrl"
                           placeholder="Leave blank unless the server has moved" />
                    <p class="hint">
                        Only needed if a server changes domain. An internal host
                        also needs listing in
                        <span class="mono">Herald__AllowedPrivateHosts</span>.
                    </p>
                    <span class="hint" asp-validation-for="Input.HeraldBaseUrl"></span>
                </details>

                <p class="row-actions" style="margin:0">
                    <button class="btn" type="submit">Save</button>
                    <button class="linkish" type="button" data-cancel="game" hidden>cancel edit</button>
                </p>
            </form>
        </article>

        <article class="panel">
            <p class="panel__title">Links</p>
            <p class="hint" data-mode="link">Adding a new link.</p>

            <form method="post" asp-page-handler="SaveLink" class="stack" id="link-form" style="--stack-gap:1rem">
                <div asp-validation-summary="All" class="notice validation-summary"></div>
                <input type="hidden" asp-for="LinkInput.Id" />

                <div class="field">
                    <label asp-for="LinkInput.GamePresenceId">Game</label>
                    <select class="input" asp-for="LinkInput.GamePresenceId">
                        <option value="">Pick a game</option>
                        @foreach (var g in Model.Rows)
                        {
                            <option value="@g.Id">@g.Game</option>
                        }
                    </select>
                    <span class="hint" asp-validation-for="LinkInput.GamePresenceId"></span>
                </div>

                <div class="field">
                    <label asp-for="LinkInput.Kind">Kind</label>
                    <select class="input" asp-for="LinkInput.Kind"
                            asp-items="Html.GetEnumSelectList<Rmv.Web.Data.GameLinkKind>()"></select>
                    <p class="hint">Picks the little mark shown before the label.</p>
                </div>

                <div class="field">
                    <label asp-for="LinkInput.Label">Label</label>
                    <input class="input" asp-for="LinkInput.Label" placeholder="Uthgard Herald" />
                    <span class="hint" asp-validation-for="LinkInput.Label"></span>
                </div>

                <div class="field">
                    <label asp-for="LinkInput.Url">URL</label>
                    <input class="input" asp-for="LinkInput.Url" placeholder="https://herald.uthgard.net/..." />
                    <p class="hint">Absolute http or https only.</p>
                    <span class="hint" asp-validation-for="LinkInput.Url"></span>
                </div>

                <div class="field">
                    <label asp-for="LinkInput.SortOrder">Sort order</label>
                    <input class="input" asp-for="LinkInput.SortOrder" type="number" min="0" max="999" />
                </div>

                <p class="row-actions" style="margin:0">
                    <button class="btn" type="submit">Save link</button>
                    <button class="linkish" type="button" data-cancel="link" hidden>cancel edit</button>
                </p>
            </form>
        </article>

        <article class="panel">
            <p class="panel__title">Current list</p>
            <table class="table">
                <thead>
                    <tr><th scope="col">Game</th><th scope="col">Tags</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>
                            @row.Game
                            @if (row.IsActive)
                            {
                                <span class="pill pill--ok">active</span>
                            }
                            @if (row.HasHerald)
                            {
                                <span class="pill pill--ok">herald: @row.HeraldAdapterKey</span>
                            }
                            else
                            {
                                <span class="pill">no herald</span>
                            }
                        </td>
                        <td class="dim">
                            @row.Guilds
                            @if (row.Links.Count > 0)
                            {
                                <ul class="linklist">
                                    @foreach (var l in row.Links)
                                    {
                                        <li>
                                            <span class="mono">@l.DisplayLabel</span>
                                            <span class="dim">@l.Host</span>
                                            <a href="#"
                                               class="linkish"
                                               data-edit-link
                                               data-id="@l.Id"
                                               data-game="@l.GamePresenceId"
                                               data-kind="@((int)l.Kind)"
                                               data-label="@l.Label"
                                               data-url="@l.Url"
                                               data-sort="@l.SortOrder">edit</a>
                                            <form method="post" asp-page-handler="DeleteLink" asp-route-id="@l.Id"
                                                  data-confirm="Remove @l.DisplayLabel?">
                                                <button class="linkish linkish--danger" type="submit">remove</button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            }
                        </td>
                        <td class="row-actions">
                            <a href="#"
                               class="linkish"
                               data-edit
                               data-id="@row.Id"
                               data-game="@row.Game"
                               data-guilds="@row.Guilds"
                               data-period="@row.Period"
                               data-sort="@row.SortOrder"
                               data-active="@(row.IsActive ? "true" : "false")"
                               data-adapter="@row.HeraldAdapterKey"
                               data-heraldurl="@row.HeraldBaseUrl">edit</a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@row.Id"
                                  data-confirm="Delete @row.Game?">
                                <button class="linkish linkish--danger" type="submit">delete</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </article>
    </section>
</div>

@section Scripts {
<script src="~/js/admin-history.js" asp-append-version="true" defer></script>
}
