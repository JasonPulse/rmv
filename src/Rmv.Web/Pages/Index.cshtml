@page
@model IndexModel
@inject Rmv.Web.Herald.ServerStatusState Servers
@{
    ViewData["Title"] = "Hall";
    ViewData["Description"] = "Results May Vary, a gaming guild that started in Dark Age of Camelot and never quite stopped.";
}

<section class="hero">
    <div class="shell">
        @* The lockup carries the guild name as artwork, so it is the h1. The
           alt text is what a screen reader and a search engine read. *@
        <h1 class="hero__logo">
            <img src="~/img/logo/rmv-lockup.webp"
                 alt="Results May Vary, a guild since 2001, established in Dark Age of Camelot"
                 width="720" height="742" />
        </h1>
        <p>
            A guild that started swinging in the frontiers of Dark Age of Camelot
            and never got round to disbanding. We are still here, still arguing
            about pull order.
        </p>
    </div>
</section>

<div class="shell">
    <hr class="rule" />

    <div class="bar"><h2>The Hall</h2></div>

    <section class="section grid">
        <article class="panel">
            <p class="panel__title">Who we are</p>
            <h3>Twenty-some years in</h3>
            <p class="dim">
                Midgard, then everywhere else. The roster has turned over more than
                once, the guild tag has not.
            </p>
        </article>

        @* Read from memory, not the database, so the home page keeps its promise of
           rendering whatever Postgres is doing. Absent until the first check has
           run, which is a panel that is not there rather than one full of unknowns. *@
        @if (Servers.All.Count > 0)
        {
            <article class="panel panel--inset">
                <p class="panel__title">Servers</p>
                <dl class="facts">
                    @foreach (var server in Servers.All)
                    {
                        <dt>@server.Game</dt>
                        <dd>
                            @if (server.Ok)
                            {
                                <span class="pill pill--ok">up</span>
                                <span class="dim">@server.Ms ms</span>
                            }
                            else
                            {
                                <span class="pill pill--bad">not answering</span>
                            }
                        </dd>
                    }
                </dl>
                <p class="hint">
                    Checked from the site every ten minutes. It says whether the
                    server answers us, which is not quite the same as whether you
                    can log in.
                </p>
            </article>
        }

        <article class="panel">
            <p class="panel__title">Tools</p>
            <h3>Utilities for players</h3>
            <p class="dim">
                A parser for combat logs, a screenshot reader, and daily stat
                scrapes. Not built yet. This is the skeleton they will hang on.
            </p>
            <p><a class="btn" href="/tools">Look in</a></p>
        </article>

        @* Nothing to say to someone who is already in. Joining is not a thing you
           do twice, and membership is approved by an admin rather than by pressing
           a button here. *@
        @if (User.Identity?.IsAuthenticated != true)
        {
            <article class="panel">
                <p class="panel__title">Join</p>
                <h3>Ware actively not recruiting</h3>
                @* No sign-in button. The masthead owns signing in, and a second
                   entry point for it here was a way to have two. *@
                <p class="dim">
                    We are not currently accepting anyone of any game/class/level.
                    The only way to get in is to not want in.
                    We're not you, and we're god damn proud of it.
                </p>
            </article>
        }
    </section>
</div>
