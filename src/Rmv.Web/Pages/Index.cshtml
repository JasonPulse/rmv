@page
@model IndexModel
@inject SiteOptions Site
@{
    ViewData["Title"] = "Hall";
    ViewData["Description"] = "Results May Vary, a gaming guild that started in Dark Age of Camelot and never quite stopped.";
}

<section class="hero">
    <div class="shell">
        @* The lockup carries the guild name as artwork, so it is the h1. The
           alt text is what a screen reader and a search engine read. *@
        <h1 class="hero__logo">
            <img src="~/img/logo/rmv-lockup.webp"
                 alt="Results May Vary, a guild since 2001, established in Dark Age of Camelot"
                 width="720" height="742" />
        </h1>
        <p>
            A guild that started swinging in the frontiers of Dark Age of Camelot
            and never got round to disbanding. We are still here, still arguing
            about pull order.
        </p>
    </div>
</section>

<div class="shell">
    <hr class="rule" />

    <div class="bar"><h2>The Hall</h2></div>

    <section class="section grid">
        <article class="panel">
            <p class="panel__title">Who we are</p>
            <h3>Twenty-some years in</h3>
            <p class="dim">
                Albion, then everywhere else. The roster has turned over more than
                once, the guild tag has not.
            </p>
        </article>

        <article class="panel">
            <p class="panel__title">Tools</p>
            <h3>Utilities for players</h3>
            <p class="dim">
                A parser for combat logs, a screenshot reader, and daily stat
                scrapes. Not built yet. This is the skeleton they will hang on.
            </p>
            <p><a class="btn" href="/tools">Look in</a></p>
        </article>

        <article class="panel">
            <p class="panel__title">Join</p>
            <h3>Still taking people on</h3>
            @if (Site.DiscordEnabled)
            {
                <p class="dim">
                    Sign in with Discord and say hello. We are not fussy about
                    hours, only about being pleasant to raid with.
                </p>
                <p><a class="btn" href="/Account/Login">Sign in</a></p>
            }
            else
            {
                <p class="dim">
                    We are not fussy about hours, only about being pleasant to
                    raid with. Discord sign-in is not wired up yet.
                </p>
            }
        </article>
    </section>
</div>
