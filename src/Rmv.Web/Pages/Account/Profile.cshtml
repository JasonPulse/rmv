@page
@model Rmv.Web.Pages.Account.ProfileModel
@{ ViewData["Title"] = "Profile"; }

<section class="hero">
    <div class="shell">
        <div class="hero__plaque"><h1>@Model.Handle</h1></div>
    </div>
</section>

<div class="shell">
    <hr class="rule" />

    @{ var flash = new Rmv.Web.Pages.Shared.Flash(Model.Notice); }
    <partial name="_Flash" model="flash" />

    <section class="section grid grid--wide">
        <article class="panel">
            <p class="panel__title">You</p>

            <div class="profile__head">
                <span class="portrait portrait--lg">
                    @if (Model.AvatarUrl is not null)
                    {
                        <img class="portrait__img" src="@Model.AvatarUrl" alt="" width="128" height="128" />
                    }
                    else
                    {
                        <span class="portrait__initials">@Rmv.Web.Data.Member.InitialsOf(Model.Handle)</span>
                    }
                </span>
                <div>
                    <h3 style="margin:0">@Model.Handle</h3>
                    <p class="dim" style="margin:.25rem 0 0">Discord: @Model.DiscordName</p>
                </div>
            </div>

            <hr class="rule rule--fine" />

            <form method="post" asp-page-handler="Alias" class="stack" style="--stack-gap:.7rem">
                <div asp-validation-summary="All" class="notice validation-summary"></div>
                <div class="field">
                    <label asp-for="Alias">Alias</label>
                    <input class="input" asp-for="Alias" placeholder="@Model.DiscordName" autocomplete="off" />
                    <p class="hint">
                        What the site calls you. Discord names are whoever got there
                        first; this is the name people actually know you by. Blank
                        falls back to your Discord name.
                    </p>
                </div>
                <p style="margin:0"><button class="btn" type="submit">Save alias</button></p>
            </form>

            <hr class="rule rule--fine" />

            <dl class="facts">
                <dt>Status</dt>
                <dd>
                    @if (Model.IsRoot)
                    {
                        <span class="pill pill--warn">root admin</span>
                    }
                    else if (Model.Record is null)
                    {
                        <span class="pill">unknown</span>
                    }
                    else
                    {
                        <partial name="_StatusPill" model="Model.Record.Status" />
                    }
                </dd>

                @if (Model.Record is { ApprovedAt: not null })
                {
                    <dt>Approved</dt>
                    <dd>
                        @Model.Record.ApprovedAt.Value.ToString("yyyy-MM-dd")
                        @if (!string.IsNullOrWhiteSpace(Model.Record.ApprovedBy))
                        {
                            <span class="dim">by @Model.Record.ApprovedBy</span>
                        }
                    </dd>
                }

                @if (Model.Record is not null)
                {
                    <dt>First seen</dt>
                    <dd>@Model.Record.FirstSeenAt.ToString("yyyy-MM-dd")</dd>
                }
            </dl>
        </article>

        <article class="panel panel--inset">
            <p class="panel__title">Characters</p>

            @if (Model.Characters.Count > 0)
            {
                <ul class="charlines">
                    @foreach (var c in Model.Characters)
                    {
                        <li>
                            @if (!string.IsNullOrWhiteSpace(c.AvatarUrl))
                            {
                                @* The square face crop, not the portrait: a
                                   single-line list has no room for a tall image. *@
                                <img class="charlines__face" src="@c.AvatarUrl" alt=""
                                     loading="lazy" decoding="async"
                                     referrerpolicy="no-referrer" width="40" height="40" />
                            }
                            <a href="/roster/@c.MemberId?c=@c.Id">@c.Name</a>
                            <span class="charlines__game">@c.Game?.Game</span>
                            @if (!c.IsManual && !string.IsNullOrWhiteSpace(c.LastError))
                            {
                                <span class="pill pill--bad">stale</span>
                            }
                        </li>
                    }
                </ul>

                <hr class="rule rule--fine" />

                <p style="margin:0"><a class="btn" href="/characters">Add or edit</a></p>
            }
            else if (Model.CanContribute)
            {
                <h3>None yet</h3>
                <p class="dim">
                    Tell us a character name and we look it up on that server's
                    herald.
                </p>
                <p><a class="btn" href="/characters">Add a character</a></p>
            }
            else if (Model.Record is { Status: MemberStatus.Blocked })
            {
                <h3>No access</h3>
                <p class="dim">Your account has been blocked. Speak to an officer.</p>
            }
            else
            {
                <h3>Waiting on approval</h3>
                <p class="dim">
                    An admin has to approve your account before you can add
                    characters. Signing in is enough to get on the list; nudge an
                    officer if it takes a while.
                </p>
            }
        </article>
    </section>

    <p class="center">
        <form method="post" asp-page="/Account/Logout">
            <button class="btn" type="submit">Sign out</button>
        </form>
    </p>
</div>
