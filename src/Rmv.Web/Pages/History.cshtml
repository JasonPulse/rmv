@page "/history"
@model HistoryModel
@{
    ViewData["Title"] = "Where we've been";
    ViewData["Description"] = "The games Results May Vary has played, and the tags we played them under.";
}

<section class="hero">
    <div class="shell">
        <div class="hero__plaque"><h1>Where we've been</h1></div>
        <p>Twenty-odd years, several games, and a few different names.</p>
    </div>
</section>

<div class="shell">
    <hr class="rule" />

    @if (Model.DatabaseUnavailable)
    {
        <p class="notice">The roll of honour is briefly unavailable. Try again shortly.</p>
    }
    else
    {
        <div class="bar"><h2>Still going</h2></div>
        <section class="section">
            @if (Model.Active.Count == 0)
            {
                <p class="dim center">Nothing listed as active.</p>
            }
            else
            {
                <dl class="roll">
                    @foreach (var g in Model.Active)
                    {
                        <div class="roll__row">
                            <dt>
                                @g.Game
                                @if (!string.IsNullOrWhiteSpace(g.Period))
                                {
                                    <span class="roll__period">@g.Period</span>
                                }
                            </dt>
                            <dd>
                                @foreach (var tag in g.GuildList())
                                {
                                    <span class="tag">@tag</span>
                                }
                            </dd>
                        </div>
                    }
                </dl>
            }
        </section>

        <hr class="rule" />

        <div class="bar"><h2>No longer active</h2></div>
        <section class="section">
            <dl class="roll roll--past">
                @foreach (var g in Model.Past)
                {
                    <div class="roll__row">
                        <dt>
                            @g.Game
                            @if (!string.IsNullOrWhiteSpace(g.Period))
                            {
                                <span class="roll__period">@g.Period</span>
                            }
                        </dt>
                        <dd>
                            @foreach (var tag in g.GuildList())
                            {
                                <span class="tag">@tag</span>
                            }
                        </dd>
                    </div>
                }
            </dl>
        </section>
    }
</div>
