@page "/history"
@model HistoryModel
@{
    ViewData["Title"] = "Where we've been";
    ViewData["Description"] = "The games Results May Vary has played, the tags we played them under, and where to look us up.";
}

@*
    Game names are set as wordmarks in the display face rather than as logos.
    Deliberate: the logos are trademarks, and typography keeps the page visually
    consistent with the rest of the kit.
*@
@functions {
    // External links only, and the URL is validated before it is stored, so this
    // renders what the admin saved. rel is set because these all open off-site.
    string Rel() => "noopener noreferrer external";
}

<section class="hero">
    <div class="shell">
        <div class="hero__plaque"><h1>Where we've been</h1></div>
        <p>Twenty-odd years, several games, and a few different names.</p>
    </div>
</section>

<div class="shell">
    <hr class="rule" />

    @if (Model.DatabaseUnavailable)
    {
        <p class="notice">This page is briefly unavailable. Try again shortly.</p>
    }
    else
    {
        @* One list, newest first, rather than an active grid above a past grid.
           The split into two sections said the same thing twice: an entry already
           carries a "still going" pill and its own years. What it cost was reading
           order, because within each grid the games were alphabetical. *@
        var shownPast = false;

        @* A heading for the active run, hidden because the entries already carry a
           "still going" pill and their own years. It exists so the page does not
           jump from h1 straight to the h3 of the first game name, which is the
           order a screen reader user navigates by. Its visible counterpart is the
           "No longer active" bar below. *@
        <h2 class="visually-hidden">Still going</h2>

        <div class="gamelist">
            @foreach (var g in Model.Games)
            {
                @if (!g.IsActive && !shownPast)
                {
                    shownPast = true;
                    <div class="bar bar--quiet"><h2>No longer active</h2></div>
                }

                <partial name="_GameEntry" model="g" />
            }
        </div>
    }
</div>
